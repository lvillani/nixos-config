#!/usr/bin/env python3

import argparse
import json
import typing
import urllib.request


ENDPOINT = "https://mcp.exa.ai/mcp"
PROTOCOL_VERSION = "2025-03-26"


def main() -> None:
    args = parse_args()

    if args.command == "search":
        call_tool("web_search_exa", {"query": args.query})
    else:
        call_tool("web_fetch_exa", {"urls": [args.url]})


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)

    search_parser = subparsers.add_parser("search")
    search_parser.add_argument("query")

    fetch_parser = subparsers.add_parser("fetch")
    fetch_parser.add_argument("url")

    return parser.parse_args()


def call_tool(name, arguments) -> None:
    session_id, _ = request(
        {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
                "protocolVersion": PROTOCOL_VERSION,
                "capabilities": {},
                "clientInfo": {"name": "web-search-and-fetch", "version": "1.0"},
            },
        }
    )
    request(
        {"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}},
        session_id,
    )
    _, response = request(
        {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "tools/call",
            "params": {"name": name, "arguments": arguments},
        },
        session_id,
    )
    print("\n".join(item["text"] for item in response["result"]["content"]))


def request(
    message, session_id=None
) -> typing.Tuple[typing.Optional[str], typing.Optional[dict]]:
    headers = {
        "Accept": "application/json, text/event-stream",
        "Content-Type": "application/json",
        "MCP-Protocol-Version": PROTOCOL_VERSION,
        "User-Agent": "web-search-and-fetch/1.0",
    }
    if session_id:
        headers["Mcp-Session-Id"] = session_id

    request = urllib.request.Request(
        ENDPOINT,
        data=json.dumps(message).encode(),
        headers=headers,
        method="POST",
    )
    with urllib.request.urlopen(request) as response:
        body = response.read().decode()
        session_id = response.headers.get("Mcp-Session-Id", session_id)

    if not body:
        return session_id, None

    data = next(line[6:] for line in body.splitlines() if line.startswith("data: "))
    return session_id, json.loads(data)


if __name__ == "__main__":
    main()
